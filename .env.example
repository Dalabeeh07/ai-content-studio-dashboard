NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ADMIN_PASSWORD=

# Secures app/api/cron/cleanup - Vercel sends this back as
# `Authorization: Bearer <value>` when it invokes the cron job (see
# vercel.json). A random string of 16+ characters, per Vercel's own
# recommendation.
CRON_SECRET=

# Stripe (upgrade flow) — see app/api/stripe/create-checkout-session and
# app/api/stripe/webhook. STRIPE_PRO_PRICE_ID is the Price ID for the one
# upgrade tier (create it in the Stripe dashboard as a recurring price).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Telegram link-intake bot (@PlovikaLinksBot) - see docs/telegram-bot.md.
# Both are set in Vercel Production (type Secret). Put them here ONLY for local
# runs / scripts/set-telegram-webhook.mjs; this file is git-ignored.
TELEGRAM_BOT_TOKEN=
# 16-256 chars of A-Z a-z 0-9 _ - ; sent by Telegram in X-Telegram-Bot-Api-Secret-Token,
# and also the root of the link-code hash key (rotating it invalidates unused codes).
TELEGRAM_WEBHOOK_SECRET=
# Only used by scripts/set-telegram-webhook.mjs:
# TELEGRAM_WEBHOOK_URL=https://<your-dashboard-domain>/api/telegram/webhook
